# ============ 生产环境配置模板(复制为 .env.production 后填写) ============
# 注意: 本文件为占位符模板,请复制为 .env.production 并填入真实密钥。
# 真实密钥文件已被 .gitignore 排除,不会提交到仓库。

# LLM配置 - 必填
LLM_MODEL_ID=your-model-id
LLM_FLASH_MODEL=your-flash-model
LLM_PRO_MODEL=your-pro-model
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS(改成你的线上域名/IP)
CORS_ORIGINS=https://your-domain.com,http://your-server-ip

# 日志级别
LOG_LEVEL=INFO

# ===== 安全配置 =====
# 生产环境关闭API文档、开启限流与请求体限制(默认即安全,可保持)
DOCS_ENABLED=false
ENABLE_RATE_LIMIT=true
MAX_BODY_SIZE=65536

# 数据库(生产使用PostgreSQL,由docker-compose注入连接串)
# DATABASE_URL=postgresql+psycopg2://trip:你的密码@postgres:5432/trip_planner
# PostgreSQL用户名(默认trip,可自定义,如改成你的昵称)
POSTGRES_USER=trip

# 并发控制: 同时最多执行的生成任务数(100并发目标下建议8-10)
MAX_CONCURRENT_GENERATIONS=8
# 单个生成任务超时(秒)
TASK_TIMEOUT=180

# Unsplash (可选,留空则跳过图片搜索)
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API - 必填
AMAP_API_KEY=your-amap-api-key-here

# 高德Web端(JS API) Key - 必填(地图显示用,需在高德控制台为JS应用创建并在域名白名单加入你的IP/域名)
VITE_AMAP_WEB_JS_KEY=your-amap-js-api-key-here